#!/usr/bin/env python
# SPDX-License-Identifier: MIT
#SCsub


##### ENVIROMENT #####

Import('env')
mysql_env = env.Clone()


##### CONFIG (config.cfg) #####

# Caminhos do Boost/OpenSSL e modo de compilação vêm de config.cfg, na pasta do módulo.
# Ver documentation/compilation.md.
#
# Compilar pra mais de uma plataforma a partir da mesma pasta do módulo (Fase 7 —
# portabilidade) exige caminhos diferentes por plataforma (cada uma tem seu próprio
# Boost/OpenSSL compilados). Em vez de um config.cfg só, com um platform= por vez, um
# config.<platform>.cfg (ex.: config.windows.cfg) é lido no lugar de config.cfg quando
# existe, pro platform= daquele build — sem isso, o config.cfg "principal" (geralmente
# Linux) continua valendo pra qualquer platform= que não tenha um arquivo próprio.

import os
import re
import configparser

# SConscripts não têm __file__: usa a pasta deste SCsub.
_module_dir = Dir(".").srcnode().abspath
_platform_config_file = os.path.join(_module_dir, "config.%s.cfg" % env["platform"])
_config_file = _platform_config_file if os.path.isfile(_platform_config_file) else os.path.join(_module_dir, "config.cfg")

_cfg = configparser.ConfigParser()
if not _cfg.read(_config_file):
	print("mysql: arquivo de configuração não encontrado: " + _config_file)
	Exit(255)
print("mysql: usando " + _config_file)


def _cfg_path(key):
	path = os.path.normpath(os.path.join(_module_dir, os.path.expanduser(_cfg.get("paths", key))))
	if not os.path.isdir(path):
		print("mysql: config.cfg [paths] %s aponta para uma pasta inexistente: %s" % (key, path))
		Exit(255)
	return path


def _check_boost(path):
	# Confere headers e versão mínima (1.85: quando o Boost.MySQL passou a exigir
	# Boost.Charconv compilado) antes de deixar um erro de link mais tarde e mais
	# difícil de entender explicar o problema.
	mysql_header = os.path.join(path, "boost", "mysql.hpp")
	version_header = os.path.join(path, "boost", "version.hpp")
	if not os.path.isfile(version_header) or not os.path.isfile(mysql_header):
		print("mysql: boost_path (%s) não parece uma árvore do Boost compilada (falta boost/version.hpp ou boost/mysql.hpp; use um clone completo de boostorg/boost, que traz o Boost.MySQL desde a 1.82)" % path)
		Exit(255)
	with open(version_header) as f:
		match = re.search(r"#\s*define\s+BOOST_VERSION\s+(\d+)", f.read())
	if not match:
		print("mysql: não consegui ler BOOST_VERSION em %s" % version_header)
		Exit(255)
	version = int(match.group(1))
	if version < 108500:
		print("mysql: Boost %d.%d.%d é anterior ao mínimo exigido (1.85.0)" % (version // 100000, (version // 100) % 1000, version % 100))
		Exit(255)


def _check_openssl_include(path):
	include = os.path.join(path, "include")
	ssl_header = os.path.join(include, "openssl", "ssl.h")
	version_header = os.path.join(include, "openssl", "opensslv.h")
	if not os.path.isfile(ssl_header) or not os.path.isfile(version_header):
		print("mysql: openssl_path (%s) não parece uma árvore do OpenSSL compilada (falta include/openssl/ssl.h ou opensslv.h)" % path)
		Exit(255)
	with open(version_header) as f:
		match = re.search(r"#\s*define\s+OPENSSL_VERSION_MAJOR\s+(\d+)", f.read())
	if not match or int(match.group(1)) < 3:
		print("mysql: openssl_path (%s) é anterior ao mínimo exigido (OpenSSL 3.0) ou a versão não pôde ser lida em opensslv.h" % path)
		Exit(255)
	return include


def _openssl_lib_path(path):
	# lib64/ ou lib/, dependendo de como o OpenSSL foi configurado — não fixo, ver B9
	# da auditoria (documentation/roadmap.md, Fase 0).
	for subdir in ("lib64", "lib"):
		candidate = os.path.join(path, subdir)
		if os.path.isfile(os.path.join(candidate, "libssl.a")) and os.path.isfile(os.path.join(candidate, "libcrypto.a")):
			return candidate
	print("mysql: não encontrei libssl.a/libcrypto.a em %s/lib64 nem em %s/lib — confira openssl_path no config.cfg" % (path, path))
	Exit(255)


boost_path = _cfg_path("boost_path")
openssl_path = _cfg_path("openssl_path")

_check_boost(boost_path)

# Sem valor padrão embutido aqui: a opção precisa estar definida no config.cfg.
if not _cfg.has_option("build", "boost_mysql_mode"):
	print("mysql: config.cfg [build] boost_mysql_mode não está definido ('header-only' ou 'separate')")
	Exit(255)
boost_mysql_mode = _cfg.get("build", "boost_mysql_mode").strip().lower()
if boost_mysql_mode not in ("header-only", "separate"):
	print("mysql: config.cfg [build] boost_mysql_mode deve ser 'header-only' ou 'separate' (valor atual: '%s')" % boost_mysql_mode)
	Exit(255)

boost_include_path = boost_path
boost_lib_path = os.path.join(boost_path, "stage", "lib")
if not os.path.isfile(os.path.join(boost_lib_path, "libboost_charconv.a")):
	print("mysql: não encontrei libboost_charconv.a em %s — rode o b2 conforme documentation/compilation.md" % boost_lib_path)
	Exit(255)

openssl_include_path = _check_openssl_include(openssl_path)
openssl_lib_path = _openssl_lib_path(openssl_path)


##### FLAGS #####

# C++17, sem exceções (padrão do Godot: disable_exceptions=yes). Nenhuma
# flag de exceção é adicionada aqui; o módulo usa as sobrecargas
# error_code/diagnostics do Boost.MySQL.
if mysql_env.msvc:
	mysql_env.Append(CXXFLAGS=["/std:c++17"])
else:
	mysql_env.Append(CPPFLAGS=["-std=c++17"])

if boost_mysql_mode == "separate":
	mysql_env.Append(CPPDEFINES=["BOOST_MYSQL_SEPARATE_COMPILATION"])


##### GODOT MODULE #####

# INCLUDE:
mysql_env.Prepend(CPPPATH=[
	openssl_include_path,
	boost_include_path,
])

# LIB
env.Prepend(LIBPATH=[
	openssl_lib_path,
	boost_lib_path,
])

mysql_env.add_source_files(env.modules_sources, "*.cpp")
mysql_env.add_source_files(env.modules_sources, "scr/**.cpp")


# Dependências de link do Boost.MySQL (documentação "Integrating Boost.MySQL"):
# Boost.Charconv (única lib do Boost com parte compilada), OpenSSL (SSL + Crypto)
# e Threads (pthread já vem do Godot). Boost.Context só seria necessário com
# asio::spawn/yield_context, que o módulo não usa.
# Ordem importa nas libs estáticas: libssl depende de libcrypto, então vem antes.
env.Prepend(LIBS=["libboost_charconv", "libssl", "libcrypto"])
