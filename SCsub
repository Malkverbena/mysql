#!/usr/bin/env python
#SCsub


##### ENVIROMENT #####

Import('env')
mysql_env = env.Clone()


##### CONFIG (config.cfg) #####

# Caminhos do Boost/OpenSSL e modo de compilação vêm de config.cfg, na
# pasta do módulo. Ver documentation/compilation.md.

import os
import configparser

# SConscripts não têm __file__: usa a pasta deste SCsub.
_module_dir = Dir(".").srcnode().abspath
_config_file = os.path.join(_module_dir, "config.cfg")

_cfg = configparser.ConfigParser()
if not _cfg.read(_config_file):
	print("mysql: arquivo de configuração não encontrado: " + _config_file)
	Exit(255)


def _cfg_path(key):
	path = os.path.normpath(os.path.join(_module_dir, os.path.expanduser(_cfg.get("paths", key))))
	if not os.path.isdir(path):
		print("mysql: config.cfg [paths] %s aponta para uma pasta inexistente: %s" % (key, path))
		Exit(255)
	return path


boost_path = _cfg_path("boost_path")
openssl_path = _cfg_path("openssl_path")

# Sem valor padrão embutido aqui: a opção precisa estar definida no config.cfg.
if not _cfg.has_option("build", "boost_mysql_mode"):
	print("mysql: config.cfg [build] boost_mysql_mode não está definido ('header-only' ou 'separate')")
	Exit(255)
boost_mysql_mode = _cfg.get("build", "boost_mysql_mode").strip().lower()
if boost_mysql_mode not in ("header-only", "separate"):
	print("mysql: config.cfg [build] boost_mysql_mode deve ser 'header-only' ou 'separate' (valor atual: '%s')" % boost_mysql_mode)
	Exit(255)

boost_include_path = boost_path
boost_lib_path = os.path.join(boost_path, "stage", "lib")
openssl_include_path = os.path.join(openssl_path, "include")
openssl_lib_path = os.path.join(openssl_path, "lib64")


##### FLAGS #####

# C++17, sem exceções (padrão do Godot: disable_exceptions=yes). Nenhuma
# flag de exceção é adicionada aqui; o módulo usa as sobrecargas
# error_code/diagnostics do Boost.MySQL.
if mysql_env.msvc:
	mysql_env.Append(CXXFLAGS=["/std:c++17"])
else:
	mysql_env.Append(CPPFLAGS=["-std=c++17"])

if boost_mysql_mode == "separate":
	mysql_env.Append(CPPDEFINES=["BOOST_MYSQL_SEPARATE_COMPILATION"])


##### GODOT MODULE #####

# INCLUDE:
mysql_env.Prepend(CPPPATH=[
	openssl_include_path,
	boost_include_path,
])

# LIB
env.Prepend(LIBPATH=[
	openssl_lib_path,
	boost_lib_path,
])

mysql_env.add_source_files(env.modules_sources, "*.cpp")
mysql_env.add_source_files(env.modules_sources, "scr/**.cpp")


# Dependências de link do Boost.MySQL (documentação "Integrating Boost.MySQL"):
# Boost.Charconv (única lib do Boost com parte compilada), OpenSSL (SSL + Crypto)
# e Threads (pthread já vem do Godot). Boost.Context só seria necessário com
# asio::spawn/yield_context, que o módulo não usa.
# Ordem importa nas libs estáticas: libssl depende de libcrypto, então vem antes.
env.Prepend(LIBS=["libboost_charconv", "libssl", "libcrypto"])
